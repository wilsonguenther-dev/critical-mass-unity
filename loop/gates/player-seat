#!/usr/bin/env python3
"""Gate "player-seat" (player-experience rebuild, 2026-11-22): does a human's press land, kill and show?

  loop/gates/player-seat [--remote] [--no-push] [--skip-f] [--library DIR] [--max-wait MIN]

  tier S  the no-Unity sim tests of category PlayerSeat (Assets/_Game/Sim.Tests/PlayerSeat, ~30 s):
          locally through tools/ci/sim-tests-mac.sh (Unity's bundled compiler and Mono, no editor process), or with
          --remote through `loop/gates/remote sim --suite fast --on air` (the fast suite holds PlayerSeat; only PlayerSeat
          failures count here, any other red is the fast gate's business and is reported as other_failures)
  tier F  the play-mode tests of category PlayerSeat (Assets/_Game/Runtime.PlayTests/PlayerSeat) through
          `loop/gates/remote playmode --category PlayerSeat` (GitHub, Unity licence secret). Never run on the Mac's Unity slot.

Prints ONE JSON line (also appended to loop/logs/gates.jsonl), the gate.py convention. Exit: 0 only when BOTH tiers
pass; 1 when either tier fails; 78 when nothing failed but a tier did not run (--skip-f, no licence, the runner could not
start or timed out): a skipped tier F is INCOMPLETE, never a pass. 64 usage. The soak (Slow + PlayerSeatSoak) is not part
of this gate: run it with `tools/ci/sim-tests-mac.sh --slow PlayerSeatImpactSoak`.
"""
import argparse
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
SKIP = 78


def root():
    try:
        return Path(subprocess.run(['git', 'rev-parse', '--show-toplevel'], capture_output=True, text=True, check=True).stdout.strip())
    except Exception:
        return HERE.parent.parent


def utc():
    return datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def last_json(text):
    for line in reversed((text or '').strip().splitlines()):
        line = line.strip()
        if line.startswith('{') and line.endswith('}'):
            try:
                return json.loads(line)
            except ValueError:
                continue
    return None


def tier_s_local(proj, lib):
    cmd = ['bash', str(proj / 'tools/ci/sim-tests-mac.sh')] + (['--library', lib] if lib else []) + ['PlayerSeat']
    try:
        p = subprocess.run(cmd, cwd=proj, capture_output=True, text=True, timeout=900)
    except subprocess.TimeoutExpired:
        return {'status': 'incomplete', 'why': 'tier S timed out after 900 s', 'runner': 'mac'}
    out = p.stdout + p.stderr
    m = re.search(r'passed (\d+), failed (\d+), not run (\d+)', out)
    fails = sorted(set(re.findall(r'^FAIL (PlayerSeat\S+)', out, re.M)))
    log = proj / 'loop/logs/player-seat-tier-s.txt'
    log.parent.mkdir(parents=True, exist_ok=True)
    log.write_text(out)
    if p.returncode == SKIP or not m:
        return {'status': 'incomplete', 'why': 'tier S did not run (exit %d)' % p.returncode, 'runner': 'mac', 'log': str(log)}
    passed, failed = int(m.group(1)), int(m.group(2))
    if passed + failed == 0:
        return {'status': 'incomplete', 'why': 'no PlayerSeat test ran', 'runner': 'mac', 'log': str(log)}
    return {'status': 'pass' if failed == 0 and p.returncode == 0 else 'fail', 'passed': passed, 'failed': failed,
            'failing': fails[:80], 'runner': 'mac', 'log': str(log)}


def remote(proj, args, extra):
    cmd = [str(HERE / 'remote')] + args + extra
    try:
        p = subprocess.run(cmd, cwd=proj, capture_output=True, text=True, timeout=(int(extra[extra.index('--max-wait') + 1]) + 15) * 60 if '--max-wait' in extra else 10800)
    except subprocess.TimeoutExpired:
        return SKIP, {'status': 'timed-out', 'reason': 'player-seat: the remote call outlived its limit'}
    return p.returncode, last_json(p.stdout) or {'status': 'no-output', 'stderr': p.stderr.strip()[-300:]}


def fail_names(rec):
    d = rec.get('detail') if isinstance(rec.get('detail'), dict) else {}
    names = d.get('fails') or d.get('failed_tests') or []
    return [n if isinstance(n, str) else json.dumps(n) for n in names]


def tier_s_remote(proj, extra):
    code, rec = remote(proj, ['sim', '--suite', 'fast', '--on', 'air'], extra)
    base = {'runner': rec.get('runner', 'github'), 'run': rec.get('run'), 'results': rec.get('results')}
    if code in (75, SKIP):
        return dict(base, status='incomplete', why='remote sim exit %d: %s' % (code, rec.get('reason') or rec.get('status')))
    names = fail_names(rec)
    mine = [n for n in names if 'PlayerSeat' in n]
    other = [n for n in names if 'PlayerSeat' not in n]
    if code == 0:
        return dict(base, status='pass', other_failures=0)
    if mine:
        return dict(base, status='fail', failed=len(mine), failing=mine[:80], other_failures=len(other))
    if names:
        return dict(base, status='pass', other_failures=len(other), note='the fast suite is red outside PlayerSeat')
    return dict(base, status='fail', why='remote sim failed with no test names (exit %d, status %s)' % (code, rec.get('status')))


def tier_f(proj, extra):
    code, rec = remote(proj, ['playmode', '--category', 'PlayerSeat'], extra)
    base = {'runner': 'github', 'run': rec.get('run'), 'url': rec.get('url'), 'results': rec.get('results'),
            'detail': rec.get('detail')}
    if code == 0:
        return dict(base, status='pass')
    if code in (75, SKIP):
        return dict(base, status='incomplete', why='remote playmode exit %d: %s' % (code, rec.get('reason') or rec.get('status')))
    return dict(base, status='fail', exit=code)


def main():
    ap = argparse.ArgumentParser(add_help=True)
    ap.add_argument('--remote', action='store_true', help='tier S on the Air (falls back to GitHub) instead of this Mac')
    ap.add_argument('--no-push', action='store_true')
    ap.add_argument('--skip-f', action='store_true', help='tier S only: the gate then exits 78 (incomplete), never 0')
    ap.add_argument('--library', default=os.environ.get('CM_PX_LIBRARY', str(Path.home() / 'critical-mass-unity/Library')))
    ap.add_argument('--max-wait', default='150')
    try:
        a = ap.parse_args()
    except SystemExit:
        return 64
    proj = root()
    extra = (['--no-push'] if a.no_push else []) + ['--max-wait', str(a.max_wait)]
    s = tier_s_remote(proj, extra) if a.remote else tier_s_local(proj, a.library)
    f = {'status': 'incomplete', 'why': 'skipped (--skip-f)'} if a.skip_f else tier_f(proj, extra)
    states = (s['status'], f['status'])
    if 'fail' in states:
        status, code = 'fail', 1
    elif states == ('pass', 'pass'):
        status, code = 'pass', 0
    else:
        status, code = 'incomplete', SKIP
    sha = subprocess.run(['git', 'rev-parse', 'HEAD'], cwd=proj, capture_output=True, text=True).stdout.strip()[:12]
    rec = {'gate': 'player-seat', 'ts': utc(), 'sha': sha, 'status': status, 'exit': code, 'tier_s': s, 'tier_f': f}
    line = json.dumps(rec, sort_keys=True)
    print(line, flush=True)
    logs = proj / 'loop/logs'
    logs.mkdir(parents=True, exist_ok=True)
    with open(logs / 'gates.jsonl', 'a') as fh:
        fh.write(line + '\n')
    return code


if __name__ == '__main__':
    sys.exit(main())
