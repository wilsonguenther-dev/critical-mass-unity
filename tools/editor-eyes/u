#!/bin/bash
# u <timeout-seconds> <unity command args...>
# Runs one `unity command` against the cm-editor Editor only: stdin closed, hard timeout, pinned project path.
t="$1"; shift
export PATH="$HOME/.unity/bin:$PATH"
export UNITY_PROJECT_PATH="$HOME/cm-editor"
exec timeout "$t" unity command --project-path "$HOME/cm-editor" "$@" </dev/null
