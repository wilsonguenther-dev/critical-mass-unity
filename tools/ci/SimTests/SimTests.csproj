<!-- No-Unity build and run of CriticalMass.Sim.Tests (ci/offload, 2026-11-13): the test sources compiled with C# 9 and
     the UNITY_INCLUDE_TESTS define (the asmdef's defineConstraint), run by NUnitLite (full NUnit semantics: TestCase,
     SetUp/TearDown, Explicit, Ignore, Category filters, NUnit 3 result XML). Run from the repo root: the tests read
     tools/golden and Assets/ relative to the working directory, as they do in the editor. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <AssemblyName>CriticalMass.Sim.Tests</AssemblyName>
    <RootNamespace>CriticalMass.Sim.Tests</RootNamespace>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <DefineConstants>$(DefineConstants);UNITY_INCLUDE_TESTS;$(CmDefines)</DefineConstants>
    <NoWarn>$(NoWarn);1591;0618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../Assets/_Game/Sim.Tests/**/*.cs" Exclude="../../../Assets/_Game/Sim.Tests/**/*~/**" />
    <Compile Include="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Sim/Sim.csproj" />
    <!-- Unity's com.unity.ext.nunit is a custom NUnit 3.5; 3.14 is the last 3.x and a superset of that API. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnitLite" Version="3.14.0" />
  </ItemGroup>
</Project>
