{
  "schema": "cm.lore.tokens/1",
  "syntax": "{cfg:id} is a GameConfig value resolved by path and format; {run:id} is filled by the screen that shows the line",
  "formats": [
    {
      "id": "number",
      "rule": "the value, invariant culture, at most one decimal, trailing zeros dropped (2.5, 0.1, 160)"
    },
    {
      "id": "clock",
      "rule": "seconds as m:ss (480 -> 8:00)"
    },
    {
      "id": "percent",
      "rule": "value x 100, rounded (0.6 -> 60)"
    },
    {
      "id": "percentOff",
      "rule": "(1 - value) x 100, rounded: the share a multiplier takes away (0.5 -> 50)"
    },
    {
      "id": "ticksAsSeconds",
      "rule": "value / SimHz, then as number (45 ticks -> 1.5)"
    }
  ],
